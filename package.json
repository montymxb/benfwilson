{
  "name": "benfwilson",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build-posts && vite",
    "build-posts": "node scripts/build-posts.js",
    "generate-pages": "node scripts/generate-pages.js",
    "generate-feeds": "node scripts/generate-feeds.js",
    "build": "npm run build-posts && vite build && npm run generate-pages && npm run generate-feeds",
    "watch": "nodemon --watch src/posts/ --ext md --exec 'npm run build'",
    "lint": "eslint .",
    "clean": "rm -rf dist src/utils/posts.js",
    "preview": "vite preview",
    "optimize:images": "bash scripts/optimize-images.sh",
    "lint:prose": "vale src/posts/"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "marked-react": "^3.0.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^7.8.0"
  },
  "engines": {
    "npm": ">= 10.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "vite": "^7.1.0",
    "nodemon": "3.1.14"
  }
}
